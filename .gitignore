# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]

# Distribution / packaging
*.egg-info/
wheels/

# Virtual environments
.venv/

# OS generated files
.DS_Store
._*
Thumbs.db
Desktop.ini
*~

# Tools
.ruff_cache/
.pytest_cache/
